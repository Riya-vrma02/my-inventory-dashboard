# Copy this file to .env and fill in real values.
# If your password contains special characters (@ : / # % etc.), URL-encode them.
# Example: a password of Login@001 must be written as Login%40001 below.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/inventory_dashboard
JWT_SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
